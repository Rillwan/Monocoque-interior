# Monocoque Interiors - Hostinger (LiteSpeed / Apache)

Options -Indexes -MultiViews
DirectoryIndex index.html
ServerSignature Off
AddDefaultCharset UTF-8

ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. www -> non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 2. Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 3. Never serve private or development files
RewriteRule ^(_private|mail-rate|phpmailer|node_modules)(/|$) - [F,L,NC]
RewriteRule ^(mail-config\.php|package(-lock)?\.json|composer\.(json|lock)|css/input\.css)$ - [F,L,NC]

# 4. /index.html -> /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 5. /page.html -> /page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(?!404\.html)([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 6. /page/ -> /page (real folders such as /css/ are left alone)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 7. /page -> page.html (served without showing the extension)
RewriteCond %{REQUEST_URI} !^/404$ [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Block dotfiles, logs, backups and config-type files
<FilesMatch "(^\.|\.(log|bak|sql|ini|md|lock)$|^(package(-lock)?\.json|composer\.json|mail-config\.php)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
